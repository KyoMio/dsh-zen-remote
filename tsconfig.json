{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "lib",
    "declarationDir": "lib/types",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/index.ts",
    "src/wizard/status.ts",
    "src/wizard/binary.ts",
    "src/wizard/binary-io.ts",
    "src/wizard/routes.ts",
    "src/wizard/caddy.ts",
    "src/wizard/caddy-process.ts",
    "src/wizard/cloudflare.ts",
    "src/wizard/cloudflared.ts",
    "src/wizard/source-detect.ts",
    "src/wizard/proxy-snippets.ts"
  ],
  "exclude": [
    "src/client",
    "lib",
    "node_modules"
  ]
}
