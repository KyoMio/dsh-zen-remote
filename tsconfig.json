{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "lib",
    "declarationDir": "lib/types",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/index.ts",
    "src/state-store.ts",
    "src/relay-pool.ts",
    "src/peer/crypto.ts",
    "src/peer/wire.ts",
    "src/adapters/dsh-better-sidebar/surface.ts",
    "src/cli/config-writer.ts",
    "src/cli/ipc-server.ts",
    "src/cli/args.ts",
    "src/cli/i18n.ts",
    "src/cli/qr-terminal.ts",
    "src/cli/ipc-client.ts",
    "src/cli/bootstrap.ts",
    "src/cli/context.ts",
    "src/cli/commands-status.ts",
    "src/cli/commands-client.ts",
    "src/cli/commands-host.ts",
    "src/cli/command-setup.ts",
    "src/cli/main.ts",
    "src/client-data/qr.ts",
    "src/wizard/status.ts",
    "src/wizard/binary.ts",
    "src/wizard/binary-io.ts",
    "src/wizard/routes.ts",
    "src/wizard/caddy.ts",
    "src/wizard/caddy-process.ts",
    "src/wizard/cloudflare.ts",
    "src/wizard/cloudflared.ts",
    "src/wizard/source-detect.ts",
    "src/wizard/proxy-snippets.ts",
    "src/wizard/probe.ts",
    "src/wizard/verify.ts"
  ],
  "exclude": [
    "src/client",
    "lib",
    "node_modules"
  ]
}
